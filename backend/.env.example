# Copy to backend/.env and fill in. Never commit .env.
DATABASE_URL=          # Tiger Data service connection string (postgres://...)
GEMINI_API_KEY=        # aistudio.google.com -> API keys
BACKBOARD_API_KEY=     # app.backboard.io -> API keys
ELEVENLABS_API_KEY=    # elevenlabs.io -> Developers -> API keys
GMAIL_ADDRESS=          # the Gmail account to read
GMAIL_APP_PASSWORD=     # myaccount.google.com/apppasswords (needs 2-Step Verification)
ELEVENLABS_VOICE_ID=    # optional; defaults to the first voice on the account
